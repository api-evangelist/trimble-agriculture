            ]
          },
          "docs": "Returns all farms for an organization."
        },
        {
          "info": {
            "name": "Create Farm",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.api.trimble.com/Trimble-Ag-Software/externalApi/3.0/organizations/:organizationId/farms",
