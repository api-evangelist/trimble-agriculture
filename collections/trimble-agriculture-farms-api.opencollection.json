        {
          "info": {
            "name": "Delete Farm",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.api.trimble.com/Trimble-Ag-Software/externalApi/3.0/organizations/:organizationId/farms/:farmId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
